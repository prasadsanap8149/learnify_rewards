# Environment Configuration
# Copy this file to .env.development, .env.staging, .env.production
# and fill in the appropriate values for each environment

# =============================================================================
# FIREBASE CONFIGURATION
# =============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abcdef123456

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
ENVIRONMENT=development
DEBUG_MODE=true
API_TIMEOUT=30000

# =============================================================================
# ENCRYPTION SETTINGS (Client-side only - no server costs)
# =============================================================================
# Base64 encoded encryption key (generate with: openssl rand -base64 32)
ENCRYPTION_MASTER_KEY=your-base64-encoded-key-here
ENCRYPTION_KEY_DERIVATION_ITERATIONS=100000

# =============================================================================
# MANUAL SETTLEMENT CONFIGURATION (No server costs)
# =============================================================================
# Settlement processing happens client-side in admin app
SETTLEMENT_ENABLED=true
SETTLEMENT_MIN_AMOUNT=500
SETTLEMENT_MAX_AMOUNT=50000
SETTLEMENT_PROCESSING_CUTOFF_DAY=25

# =============================================================================
# AD NETWORK CONFIGURATION
# =============================================================================
# Google AdMob
ADMOB_APP_ID_ANDROID=ca-app-pub-123~456
ADMOB_APP_ID_IOS=ca-app-pub-123~789
ADMOB_BANNER_ANDROID=ca-app-pub-123/456
ADMOB_BANNER_IOS=ca-app-pub-123/789
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-123/456
ADMOB_INTERSTITIAL_IOS=ca-app-pub-123/789
ADMOB_REWARDED_ANDROID=ca-app-pub-123/456
ADMOB_REWARDED_IOS=ca-app-pub-123/789

# =============================================================================
# SECURITY SETTINGS (Client-side validation)
# =============================================================================
MAX_WITHDRAWAL_AMOUNT=50000
MIN_WITHDRAWAL_AMOUNT=500
MAX_ACTIVITIES_PER_HOUR=15
MAX_DEVICES_PER_USER=3
ENABLE_BIOMETRIC_AUTH=true
ENABLE_FRAUD_DETECTION=true

# =============================================================================
# COMPLIANCE SETTINGS
# =============================================================================
COPPA_COMPLIANCE_ENABLED=true
GDPR_COMPLIANCE_ENABLED=true
DATA_RETENTION_DAYS=2555
AUDIT_LOG_RETENTION_DAYS=2555
PARENTAL_CONSENT_REQUIRED=true

# =============================================================================
# FEATURE FLAGS (No server dependency)
# =============================================================================
FEATURE_ADS_ENABLED=true
FEATURE_AER_ENABLED=true
FEATURE_STREAK_BONUS_ENABLED=true
FEATURE_REFERRAL_ENABLED=true
FEATURE_WITHDRAWAL_ENABLED=true
FEATURE_BIOMETRIC_LOGIN=true
FEATURE_OFFLINE_MODE=true

# =============================================================================
# RATE LIMITING (Client-side enforcement)
# =============================================================================
DAILY_EARNINGS_LIMIT_UNDER13=5000
DAILY_EARNINGS_LIMIT_13_17=10000
DAILY_EARNINGS_LIMIT_18_PLUS=20000
AER_BASE_RATE_UNDER13=50
AER_BASE_RATE_13_17=100
AER_BASE_RATE_18_PLUS=150

# =============================================================================
# ANALYTICS & MONITORING (Free tiers available)
# =============================================================================
FIREBASE_ANALYTICS_ENABLED=true
CRASHLYTICS_ENABLED=true
PERFORMANCE_MONITORING_ENABLED=true

# =============================================================================
# WITHDRAWAL METHODS CONFIGURATION
# =============================================================================
PAYPAL_ENABLED=true
BANK_TRANSFER_ENABLED=true
GIFT_CARD_ENABLED=true
CRYPTO_ENABLED=false

# =============================================================================
# TESTING & DEVELOPMENT
# =============================================================================
USE_FIREBASE_EMULATOR=true
EMULATOR_AUTH_HOST=localhost:9099
EMULATOR_FIRESTORE_HOST=localhost:8080
EMULATOR_FUNCTIONS_HOST=localhost:5001
TEST_USER_EMAIL=test@example.com
TEST_ADMIN_EMAIL=admin@example.com
